# 本地开发用：复制为 .env 再填写（.env 不会进 git）。上线给别人用请看 DEPLOY.md。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://cdn.cheaprouter.cc/v1
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-5.6-sol

# 上课中 语音转文字：任何 OpenAI 兼容 /audio/transcriptions 接口
# 默认硅基流动 SenseVoiceSmall（免费模型，国内可用），在 cloud.siliconflow.cn 申请 Key
# 在国际版 cloud.siliconflow.com 申请的 Key 要配 STT_BASE_URL=https://api.siliconflow.com/v1
# 改了 .env 不用重启后端：AI / 语音的 Key、地址、模型在下一次请求时生效（数据库和 CORS 仍需重启）
STT_API_KEY=
STT_BASE_URL=https://api.siliconflow.cn/v1
STT_MODEL=FunAudioLLM/SenseVoiceSmall
# 其他选择：Groq whisper-large-v3-turbo（$0.04/小时，https://api.groq.com/openai/v1）
#          OpenAI gpt-4o-mini-transcribe（$0.003/分钟，https://api.openai.com/v1）
# 默认 SQLite（单机）。多人共用服务器时可换成 PostgreSQL（需 uv sync --extra postgres）：
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/course_replay
DATABASE_URL=sqlite:///./data/course_replay.db
ARTIFACTS_DIR=./data/artifacts
MAX_UPLOAD_MB=100
# 不限页数：超过 40 页的材料会分批（每批 20 页、并行）交给 AI 阅读，再汇总成讲稿
MAX_PAGES_PER_AI_REQUEST=40
PAGES_PER_BATCH=20
DOCUMENT_RENDER_DPI=110
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# 账号：AI 接口会消耗服务端 API Key，默认只允许登录用户调用
AI_REQUIRES_LOGIN=true
AUTH_SESSION_DAYS=30
ALLOW_REGISTRATION=true
# 用户可在「AI 与偏好设置」里改用自己的 AI / 语音接口（Key 只存在用户浏览器）
ALLOW_CUSTOM_PROVIDERS=true
# 本地开发要用内网/本机模型（如 Ollama）时才打开
ALLOW_PRIVATE_PROVIDER_URLS=false
# 题目答疑「从网盘选择」允许的网盘（Seafile 共享链接），逗号分隔
CLOUD_DRIVE_HOSTS=cloud.tsinghua.edu.cn
