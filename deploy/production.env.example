# Production settings for deploy/docker-compose.yml.
# On the server:  cp production.env.example production.env  and fill it in.
# production.env is git-ignored — never commit it. A blank value means "use the default".

APP_ENV=production

# Encrypts users' notes, transcripts, questions and titles in the database.
# Generate once:  python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy somewhere safe (password manager). Lose it = the stored notes can't be read.
DATA_ENCRYPTION_KEY=

# Blank = SQLite inside the api-data volume (fine for one server; back it up).
# Or a Postgres URL, e.g. from Neon:  postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The site allowed to call this API (your GitHub Pages address, no trailing slash).
CORS_ORIGINS=https://hqching77.github.io

# Set by the Caddy proxy in this folder. Don't change.
CLIENT_IP_HEADER=X-Real-IP

# Server-side AI: any OpenAI-compatible API. Leave blank to make users enter their own key in 设置.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_VISION_MODEL=

# Speech-to-text for 上课中. Default: SiliconFlow SenseVoiceSmall (key from cloud.siliconflow.cn).
STT_API_KEY=
STT_BASE_URL=https://api.siliconflow.cn/v1
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# Set to false once your friends have signed up, to stop strangers registering.
ALLOW_REGISTRATION=true
